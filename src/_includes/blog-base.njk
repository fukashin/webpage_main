<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>{{ title }} - シヴィルドット Blog</title>
  <meta name="description" content="{{ description or title }}">
  <link rel="canonical" href="{{ page.url | url | absolute(site.url) }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title }} - シヴィルドット Blog">
  <meta property="og:description" content="{{ description or title }}">
  <meta property="og:url" content="{{ page.url | url | absolute(site.url) }}">
  <link rel="stylesheet" href="{{ '/blog/css/blog.css' | url }}">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
</head>
<body>
  <header class="blog-header">
    <div class="header-inner">
      <a href="{{ '/blog/' | url }}" class="blog-logo">civildot blog</a>
      <nav class="blog-nav">
        <a href="{{ '/blog/' | url }}">記事一覧</a>
        <a href="{{ '/' | url }}">メインサイト</a>
      </nav>
    </div>
  </header>

  <main class="blog-main">
    {{ content | safe }}
  </main>

  <footer class="blog-footer">
    <p>&copy; {{ site.company }}</p>
  </footer>
</body>
</html>
