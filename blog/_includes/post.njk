---
layout: base.njk
---

<article class="post-container">
  <div class="post-meta">
    <time>{{ date | dateFormat }}</time>
    {% if tags %}
    <div class="post-tags">
      {% for tag in tags %}
        {% if tag != "posts" %}
        <span class="tag">{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <h1 class="post-title">{{ title }}</h1>
  
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
